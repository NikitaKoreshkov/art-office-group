[Unit]
Description=ART OFFICE Next.js Site
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/art-office
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=-/opt/art-office/.env
ExecStart=/opt/art-office/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
